      <dc:title><rdf:Alt><rdf:li xml:lang="x-default">DisposiciÃ³n 1066 del BOE nÃºm. 21 de 2020</rdf:li></rdf:Alt></dc:title><dc:description><rdf:Alt><rdf:li xml:lang="x-default">BOE-A-2020-1066</rdf:li></rdf:Alt></dc:description><dc:subject><rdf:Bag><rdf:li>CIRCULAR de 15/01/2020</rdf:li><rdf:li>COMISIÃ“N NACIONAL DE LOS MERCADOS Y LA COMPETENCIA</rdf:li><rdf:li>BOE-A-2020-1066</rdf:li><rdf:li>BOE 21 de 2020</rdf:li><rdf:li>1066</rdf:li><rdf:li>24/01/2020</rdf:li></rdf:Bag></dc:subject></rdf:Description>
